# RepoVerse Environment Configuration

# Server & Environment
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]

# Database (PostgreSQL or SQLite local fallback)
# For local zero-config: sqlite+aiosqlite:///./repoverse.db
# For PostgreSQL: postgresql+psycopg://repoverse:repoverse@localhost:5432/repoverse
DATABASE_URL=sqlite+aiosqlite:///./repoverse.db

# Redis & Background Tasks (Optional for local in-process queue)
REDIS_URL=redis://localhost:6379/0

# GitHub API (Optional, for higher rate limits on metadata)
GITHUB_TOKEN=

# LLM Provider Configuration (Optional, RepoVerse runs with full deterministic fallback without an LLM)
LLM_PROVIDER=none # none, openai, gemini, anthropic
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ingestion & Security Limits
REPO_STORAGE_PATH=./repoverse_repos
MAX_REPO_SIZE_MB=150
MAX_FILE_COUNT=3000
MAX_FILE_SIZE_BYTES=1048576
CLONE_TIMEOUT_SECONDS=60
